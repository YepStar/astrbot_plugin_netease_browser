@@ -0,0 +1,65 @@
+"""Bounded, session/persona-scoped recall for optional behavior integrations."""
+
+from types import SimpleNamespace
+
+from .memory_scope import is_event_memory_allowed, require_private_memory_session
+from .passive_group_capture import is_plugin_enabled_for_session, is_session_enabled
+from .utils import get_persona_id
+
+
+async def recall_behavior_context(plugin, *, umo, persona_id, query):
+    """Recall existing private memories without ingesting messages or widening scope."""
+    try:
+        require_private_memory_session(umo)
+    except PermissionError:
+        return {"status": "denied", "memories": []}
+    if (
+        plugin._terminating
+        or not persona_id
+        or not isinstance(query, str)
+        or not query.strip()
+        or len(query) > 200
+    ):
+        return {"status": "unavailable", "memories": []}
+    if not await is_session_enabled(umo) or not await is_plugin_enabled_for_session(
+        umo
+    ):
+        return {"status": "denied", "memories": []}
+    # This is only a read scope; it is never committed as a platform/user message.
+    scope = SimpleNamespace(
+        unified_msg_origin=umo,
+        get_sender_id=lambda: umo.split(":")[-1],
+        get_sender_name=lambda: "",
+        get_platform_name=lambda: "aiocqhttp",
+        get_group_id=lambda: "",
+        is_private_chat=lambda: True,
+    )
+    if not is_event_memory_allowed(plugin.config_manager, scope):
+        return {"status": "denied", "memories": []}
+    config = plugin.context.get_config(umo=umo)
+    allowed = config.get("plugin_set", ["*"])
+    if (
+        allowed is not None
+        and "*" not in allowed
+        and not any(
+            name in allowed for name in ("LivingMemory", "astrbot_plugin_livingmemory")
+        )
+    ):
+        return {"status": "denied", "memories": []}
+    actual_persona = await get_persona_id(plugin.context, scope)
+    if not actual_persona or actual_persona != persona_id:
+        return {"status": "persona_mismatch", "memories": []}
+    engine = getattr(plugin.initializer, "memory_engine", None)
+    if engine is None:
+        return {"status": "unavailable", "memories": []}
+    rows = await engine.search_memories(
+        query=query.strip(), k=5, session_id=umo, persona_id=actual_persona
+    )
+    return {
+        "status": "ok",
+        "persona_id": actual_persona,
+        "memories": [
+            {"id": str(row.doc_id), "content": str(row.content)[:800]}
+            for row in rows[:5]
+        ],
+    }
